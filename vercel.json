{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/scholarships/eth-zurich-excellence-scholarship-opportunity-programme",
      "destination": "/scholarships/eth-zurich-excellence-scholarship-opportunity-programme-esop-2027",
      "permanent": true
    },
    {
      "source": "/scholarships/idcore-offshore-renewable-energy-engineering-doctorate-engd-september-2027-entry",
      "destination": "/scholarships/idcore-engd-in-offshore-renewable-energy-2027-entry-overseas-places",
      "permanent": true
    },
    {
      "source": "/competitions/international-schools-essay-competition-and-debate",
      "destination": "/competitions/international-schools-essay-competition-and-debate-2027-navigating-el-nino",
      "permanent": true
    },
    {
      "source": "/scholarships/maastricht-university-nl-high-potential-scholarship-2027-28",
      "destination": "/scholarships/maastricht-university-nl-high-potential-scholarship-2027",
      "permanent": true
    },
    {
      "source": "/scholarships/king-s-business-school-doctoral-research-studentships-2027-28",
      "destination": "/scholarships/king-s-business-school-doctoral-research-studentships-2027-28-round-1",
      "permanent": true
    },
    {
      "source": "/fellowships/mims-clinical-research-fellowships-2027",
      "destination": "/fellowships/mims-clinical-research-fellowships-2027-umea-university-infection-medicine",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog-proxy/feed.xml",
      "destination": "https://blog.meritleaders.com/feed.xml"
    },
    {
      "source": "/blog-proxy/home",
      "destination": "https://blog.meritleaders.com/"
    },
    {
      "source": "/blog-proxy/page/:n",
      "destination": "https://blog.meritleaders.com/page/:n"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
